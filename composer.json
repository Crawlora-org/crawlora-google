{
  "name": "crawlora/google",
  "description": "Crawlora Google API client with 40 endpoints for Maps search, places, reviews and photos; News; Trends; Finance quotes and markets; suggestions; videos; and jobs",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "google",
    "google-api",
    "google-scraper",
    "google-data",
    "google-maps-search",
    "google-places",
    "google-reviews-photos",
    "google-news",
    "google-trends",
    "google-finance-quotes-markets",
    "google-suggestions",
    "google-videos",
    "google-jobs"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Google\\": "php/src/Crawlora/Google/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Google\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=google-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-google",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=google-php-api-docs"
  }
}
